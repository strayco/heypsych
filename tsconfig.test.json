{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "noEmit": true
  },
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
