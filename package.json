{
  "name": "heypsych",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:index": "node scripts/build-resource-index.cjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "db:ensure": "node --env-file=.env.local scripts/setup/create-schemas.js",
    "seed:conditions": "node --env-file=.env.local scripts/seed-conditions-from-files.js",
    "seed:treatments": "node --env-file=.env.local scripts/seed-treatments-from-files.js",
    "seed:resources": "node --env-file=.env.local scripts/seed-resources-from-files.js",
    "seed:support": "node scripts/seed-support-resources.js",
    "seed:all": "npm run seed:conditions && npm run seed:treatments && npm run seed:resources && npm run seed:support",
    "seed:assessments": "node --env-file=.env.local scripts/seed-assessments-from-files.js",
    "seed:providers": "node --env-file=.env.local scripts/seed-providers.js",
    "seed": "npm run db:ensure && npm run seed:conditions && npm run seed:treatments && npm run seed:resources && npm run seed:assessments && npm run seed:providers",
    "seed-small": "node --env-file=.env.local scripts/seed-providers.js 25",
    "seed-large": "node --env-file=.env.local scripts/seed-providers.js 500",
    "import-nppes": "ts-node --transpile-only scripts/nppes-importer.ts",
    "import-nppes-sample": "tsx scripts/run-nppes-import.ts --sample=1000",
    "update-providers": "node --env-file=.env.local scripts/update-providers.js update",
    "cleanup-providers": "node --env-file=.env.local scripts/update-providers.js cleanup",
    "provider-stats": "node --env-file=.env.local scripts/update-providers.js stats",
    "provider-maintenance": "node --env-file=.env.local scripts/update-providers.js all",
    "sync:content": "tsx scripts/sync-json-to-db.ts",
    "sync:content:dry": "tsx scripts/sync-json-to-db.ts --dry-run",
    "sync:treatments": "tsx scripts/sync-json-to-db.ts --type=treatments",
    "sync:conditions": "tsx scripts/sync-json-to-db.ts --type=conditions",
    "sync:resources": "tsx scripts/sync-json-to-db.ts --type=resources",
    "seo:metrics": "tsx scripts/seo-metrics.ts",
    "seo:metrics:json": "tsx scripts/seo-metrics.ts --json",
    "seo:validate": "tsx scripts/validate-seo.ts",
    "audit:images": "node scripts/audit-image-alt-text.mjs",
    "audit:entity-grounding": "tsx scripts/audit-entity-grounding.ts",
    "migrate:wikidata": "tsx scripts/migrate-hardcoded-to-json.ts",
    "map:wikidata": "tsx scripts/auto-map-wikidata.ts",
    "map:wikidata:dry": "tsx scripts/auto-map-wikidata.ts --dry-run",
    "map:wikidata:conditions": "tsx scripts/auto-map-wikidata.ts --type=conditions",
    "map:wikidata:treatments": "tsx scripts/auto-map-wikidata.ts --type=treatments",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:quick": "lhci autorun --collect.numberOfRuns=1",
    "verify:hubs": "node scripts/verify-hub-pages.mjs",
    "verify:headers": "tsx scripts/verify-http-headers.ts",
    "verify:headers:prod": "tsx scripts/verify-http-headers.ts https://heypsych.com",
    "validate:sitemap": "node scripts/validate-sitemap.mjs",
    "seo:check": "bash scripts/pre-deployment-seo-check.sh",
    "seo:verify-prod": "bash scripts/verify-production-seo.sh",
    "validate:treatment": "tsx scripts/validate-treatment-json.ts",
    "validate:treatments": "tsx scripts/validate-treatment-json.ts --all",
    "validate:resources": "node scripts/validate-resources.cjs",
    "audit:resources": "node scripts/audit-resources.cjs",
    "fix:resources": "node scripts/fix-orphaned-resources.cjs",
    "fix:resources:dry": "node scripts/fix-orphaned-resources.cjs --dry-run",
    "prebuild": "npm run sync:content && npm run build:index && npm run validate:resources",
    "test": "playwright test",
    "test:e2e": "playwright test e2e/",
    "test:schema": "node scripts/validate-schema.mjs",
    "test:eat": "playwright test e2e/eat-schema-linking.spec.ts",
    "ci:validate": "npm run build && (npm run start &) && sleep 15 && npm run test:schema && npm run test:e2e",
    "ci:schema": "npm run build && (npm run start &) && sleep 15 && npm run test:schema",
    "ci:full": "npm run typecheck && npm run build && npm run ci:schema"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@supabase/supabase-js": "^2.56.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-query-devtools": "^5.84.1",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.6",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.12",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.537.0",
    "nanoid": "^5.1.6",
    "next": "^15.5.6",
    "p-limit": "^7.1.0",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-use": "^17.6.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "yargs": "^18.0.0",
    "zod": "^4.0.15",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.11",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/yargs": "^17.0.33",
    "csv-parser": "^3.2.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.6",
    "glob": "^13.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
