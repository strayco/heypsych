  "seo": {
    "title": "DeepScribe AI Scribe: Pricing, Features & Review | HeyPsych",
    "meta_description": "DeepScribe AI medical scribe review. Starting at $299/month with 14-day free trial. Custom templates, ICD coding suggestions, HIPAA compliant.",
    "faqs": [
      {
        "question": "How much does DeepScribe cost?",
        "answer": "DeepScribe starts at $299 per provider per month for the Standard plan. The Professional plan with ICD coding suggestions is $399/month. A 14-day free trial is available without credit card required."
      },
      {
        "question": "How accurate is DeepScribe?",
        "answer": "DeepScribe reports 90%+ accuracy rates that improve over time as the AI learns your documentation preferences. Most clinicians report minimal editing needed after initial customization."
      },
      {
        "question": "Does DeepScribe integrate with Epic?",
        "answer": "DeepScribe works with Epic via browser extension rather than native API integration. For practices requiring deep Epic integration, consider Abridge or Nuance DAX Copilot."
      },
      {
        "question": "Can DeepScribe suggest ICD-10 codes?",
        "answer": "Yes, the Professional plan ($399/month) includes ICD-10 coding suggestions based on the documented encounter. This can help improve coding accuracy and reduce claim denials."
      }
    ],
