  "seo": {
    "title": "Freed AI Scribe: Pricing, Features & Review 2024 | HeyPsych",
    "meta_description": "Freed AI medical scribe review for clinicians. Starting at $99/month with 7-day free trial. Compare features, pricing, EHR integrations and HIPAA compliance.",
    "faqs": [
      {
        "question": "How accurate is Freed AI for clinical documentation?",
        "answer": "Freed reports 95%+ accuracy rates for clinical documentation. The AI learns your preferences over time and improves accuracy. Most clinicians report minimal editing needed after the first few visits."
      },
      {
        "question": "Does Freed work with my EHR system?",
        "answer": "Freed works with virtually any EHR through its browser extension, allowing you to copy notes directly into your system. Native integrations are available for select EHRs. The setup takes about 5 minutes."
      },
      {
        "question": "Can I use Freed for psychiatry and mental health notes?",
        "answer": "Yes, Freed supports psychiatry and mental health documentation including therapy progress notes, psychiatric evaluations, and SOAP notes. It can capture longer sessions typical in mental health settings."
      },
      {
        "question": "What happens to my patient data with Freed?",
        "answer": "Freed is HIPAA compliant and offers BAAs. Audio recordings are processed in real-time and not stored long-term. All data is encrypted in transit and at rest. The company has SOC 2 Type II certification."
      }
    ],
