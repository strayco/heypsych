  "seo": {
    "title": "Suki AI Assistant: Pricing, Review & EHR Integrations | HeyPsych",
    "meta_description": "Suki AI voice assistant review for physicians. Starting at $199/month with 14-day free trial. Native Epic, Cerner, Athenahealth integration. HITRUST certified.",
    "faqs": [
      {
        "question": "How much does Suki cost per month?",
        "answer": "Suki starts at $199 per provider per month for the Professional plan. Enterprise pricing is available for larger organizations with volume discounts. A 14-day free trial is available without credit card."
      },
      {
        "question": "Does Suki integrate with Epic?",
        "answer": "Yes, Suki has native integration with Epic and can write notes directly into the EHR. It also integrates with Cerner, Athenahealth, eClinicalWorks, NextGen, and many other major EHR systems."
      },
      {
        "question": "Can Suki be used for mental health documentation?",
        "answer": "While Suki can generate psychiatry notes, it's not specifically designed for mental health. For therapy-specific documentation needs, consider mental health-focused tools like Mentalyc or Upheal."
      },
      {
        "question": "How does Suki learn my documentation preferences?",
        "answer": "Suki uses machine learning to analyze your edits and documentation patterns over time. The more you use it, the better it understands your preferred note structure, terminology, and style."
      }
    ],
