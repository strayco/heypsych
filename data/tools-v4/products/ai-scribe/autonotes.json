  "seo": {
    "title": "AutoNotes AI: Affordable Therapy Documentation | HeyPsych",
    "meta_description": "AutoNotes AI review - affordable AI documentation for therapists. Starting at $29/month. DAP, SOAP, treatment plans. HIPAA compliant. 7-day free trial.",
    "faqs": [
      {
        "question": "How much does AutoNotes cost?",
        "answer": "AutoNotes is one of the most affordable options starting at $29/month for 30 notes. The Pro plan at $49/month offers unlimited notes and audio transcription. Team pricing is $39/provider/month."
      },
      {
        "question": "Does AutoNotes work with SimplePractice?",
        "answer": "AutoNotes works with SimplePractice, TherapyNotes, and TheraNest via browser extension for easy copy-paste. It does not have native API integrations but the workflow is straightforward."
      },
      {
        "question": "Can I dictate notes into AutoNotes?",
        "answer": "Yes, AutoNotes supports audio input and dictation in addition to template-based entry and text input. The Pro plan includes full audio transcription features."
      },
      {
        "question": "Is AutoNotes good for real-time session transcription?",
        "answer": "AutoNotes is primarily designed for post-session documentation rather than real-time ambient AI. For real-time ambient documentation, consider Mentalyc or Upheal."
      }
    ],
