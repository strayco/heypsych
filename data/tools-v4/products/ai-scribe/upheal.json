  "seo": {
    "title": "Upheal: AI Therapy Notes + Session Analytics | HeyPsych",
    "meta_description": "Upheal review - AI therapy documentation with session analytics. Free tier available. Talk-time tracking, sentiment analysis. $59-99/month for therapists.",
    "faqs": [
      {
        "question": "What makes Upheal different from other therapy AI scribes?",
        "answer": "Upheal combines documentation with session analytics including talk-time ratios, topic tracking, and sentiment analysis. This helps therapists understand practice patterns and track client progress beyond just generating notes."
      },
      {
        "question": "How much does Upheal cost?",
        "answer": "Upheal offers a free tier with 3 sessions/month. Paid plans start at $59/month (Essential) for unlimited sessions, with the Professional plan at $99/month including full analytics. Group practices pay $79/provider/month."
      },
      {
        "question": "Does Upheal have a free version?",
        "answer": "Yes, Upheal's free tier allows 3 sessions per month indefinitely. This lets therapists try the platform before committing to a paid plan."
      },
      {
        "question": "Can Upheal track my talk-time during sessions?",
        "answer": "Yes, the Professional plan includes talk-time analysis showing the ratio of therapist vs client speaking time. This helps therapists monitor whether they're maintaining appropriate therapeutic presence."
      }
    ],
