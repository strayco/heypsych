  "seo": {
    "title": "Heidi Health AI Scribe: Free Tier & Pricing Review | HeyPsych",
    "meta_description": "Heidi Health AI scribe review with free tier option. Pro plan $89/month. HIPAA compliant, best for primary care. Compare features, pricing, and alternatives.",
    "faqs": [
      {
        "question": "Is Heidi Health really free?",
        "answer": "Yes, Heidi offers a free tier with limited consultations per month. This allows clinicians to try AI scribing without commitment. The Pro plan at $89/month offers unlimited consultations."
      },
      {
        "question": "How much does Heidi Health cost?",
        "answer": "Heidi offers a free tier with usage limits. The Pro plan is $89 per provider per month for unlimited consultations. The Team plan is $79 per provider per month (minimum 3 users). Annual billing offers 20% discount."
      },
      {
        "question": "Does Heidi Health integrate with US EHRs?",
        "answer": "Heidi works with Epic, Cerner, and Athenahealth via browser extension. Native integrations are available for Australian EHRs (Best Practice, Medical Director). For native US EHR integration, consider Suki or Freed."
      },
      {
        "question": "Is Heidi Health good for mental health practices?",
        "answer": "Heidi is primarily designed for primary care and general practice. Mental health practices would benefit more from specialized tools like Mentalyc, Upheal, or Blueprint that offer therapy-specific templates."
      }
    ],
