  "seo": {
    "title": "Mentalyc: AI Therapy Notes for Mental Health Professionals | HeyPsych",
    "meta_description": "Mentalyc AI therapy documentation review. Starting at $49/month for therapists. Generates DAP, SOAP, BIRP notes. SimplePractice integration. HIPAA compliant.",
    "faqs": [
      {
        "question": "How much does Mentalyc cost?",
        "answer": "Mentalyc starts at $49/month for 30 session notes (Starter plan). The Professional plan at $99/month offers unlimited notes and EHR integrations. Group practices pay $79/provider/month with minimum 3 providers."
      },
      {
        "question": "Does Mentalyc understand different therapy modalities?",
        "answer": "Yes, Mentalyc is trained on mental health documentation and understands therapeutic modalities including CBT, DBT, psychodynamic therapy, EMDR, and solution-focused therapy. Notes reflect the appropriate terminology and interventions."
      },
      {
        "question": "Can Mentalyc generate insurance-compliant notes?",
        "answer": "Yes, Mentalyc generates notes in formats required by insurance companies including DAP, SOAP, BIRP, and GIRP notes. The AI ensures documentation meets medical necessity requirements."
      },
      {
        "question": "Does Mentalyc integrate with SimplePractice?",
        "answer": "Yes, Mentalyc has native integration with SimplePractice, TherapyNotes, and Jane App. Notes can be exported directly to these EHRs. Other EHRs work via copy-paste or browser extension."
      }
    ],
