{
  "objectives": [
    {
      "id": "obj_complete",
      "type": "primary",
      "title": "See It Through",
      "description": "Reach any ending without leaving mid-attempt",
      "condition": {
        "type": "any-of",
        "conditions": [
          { "type": "reach-ending-quality", "quality": "positive" },
          { "type": "reach-ending-quality", "quality": "mixed" }
        ]
      },
      "showPreRun": true,
      "showInRun": false,
      "revealOnComplete": false,
      "reward": { "xpBonus": 25, "starBonus": 0, "achievementId": null }
    },
    {
      "id": "obj_stay_full_meal",
